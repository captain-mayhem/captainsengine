{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Ninja (Linux, or Windows from a developer prompt)",
      "description": "Release build with Ninja and the compiler found in PATH",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "Ninja, debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows",
      "displayName": "Visual Studio 2026 (x64)",
      "description": "Multi-config Visual Studio solution; needs no developer prompt",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "emscripten",
      "inherits": "default",
      "displayName": "Web (emscripten)",
      "description": "Uses the toolchain file of the emsdk that EMSDK points to (run emsdk_env first)",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "emscripten-threads",
      "inherits": "emscripten",
      "displayName": "Web (emscripten) with threads",
      "description": "pthreads and ASYNCIFY; the page must be served cross-origin isolated",
      "cacheVariables": {
        "CGE_WEB_THREADS": "ON"
      }
    },
    {
      "name": "android",
      "inherits": "default",
      "displayName": "Android (arm64-v8a)",
      "description": "Uses the toolchain file of the NDK that ANDROID_NDK_HOME points to",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared"
      }
    },
    {
      "name": "android-x86_64",
      "inherits": "android",
      "displayName": "Android (x86_64)",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "emscripten", "configurePreset": "emscripten" },
    { "name": "emscripten-threads", "configurePreset": "emscripten-threads" },
    { "name": "android", "configurePreset": "android" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64" }
  ],
  "testPresets": [
    {"name": "default", "configurePreset": "default", "output": {"outputOnFailure": true}},
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "windows", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "windows-debug", "configurePreset": "windows", "configuration": "Debug", "output": {"outputOnFailure": true}}
  ]
}
