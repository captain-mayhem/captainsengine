<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the engine's renderer needs OpenGL ES 3.0 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- appCategory game: Android 16 keeps the orientation fixed on large
         screens; enableOnBackInvokedCallback: back reaches CgeActivity's
         callback on Android 13 and later -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Adventure">

        <!-- the list of games (flavor player), or the copying of the packed
             game into the app's storage (flavor game); starts CgeActivity
             with the game. Not restarted by configuration changes, since
             copying runs in a thread of the activity -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.Adventure.Launcher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the engine's NativeActivity; the configuration changes don't
             restart it (the engine checks the window's size every frame),
             and only one instance runs, since the engine is a singleton -->
        <activity
            android:name="de.captain.cge.CgeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="Adventure" />
        </activity>
    </application>
</manifest>
